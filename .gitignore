# ThinkPHP 运行时缓存/日志（必须忽略）
/runtime/*
!/runtime/.gitignore

# 环境变量
.env
.env.*

# Composer 依赖（若本地重新 composer install）
/vendor/

# IDE / 编辑器
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
*.temp
*.cache

# 上传目录（若后续有用户上传文件）
/public/uploads/
/public/storage/

# 测试与覆盖率
/phpunit.xml
/tests/coverage/
.phpunit.result.cache
