# ThinkPHP 运行时缓存/日志（必须忽略）
/runtime/*
!/runtime/.gitignore

# 环境变量
.env
.env.*
!.env.example

# Composer 依赖
/vendor/

# IDE / 编辑器
.idea/
.vscode/
.HBuilderX/
.hbuilderx/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
*.temp
*.cache

# 上传目录
/public/uploads/
/public/storage/

# 测试与覆盖率
/phpunit.xml
/tests/coverage/
.phpunit.result.cache

# 本地压缩包/临时目录
*.zip
/tp_tmp/
